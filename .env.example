# Copy this file to .env and fill it in. Never put real values in this file: it's committed.

# Chat model provider: foundry (default), github or foundry_local
LLM_PROVIDER=foundry

# Microsoft Foundry / Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Leave empty for the v1 API; set only for an older versioned endpoint
AZURE_OPENAI_API_VERSION=

# GitHub Models (fallback provider; token needs the Models permission)
GITHUB_TOKEN=

# Azure AI Content Safety (free F0 tier; Keys and Endpoint page of the resource)
AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_KEY=

# Azure AI Translator (free F0 tier, region Global; the text endpoint is the same for every resource)
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global

# Application Insights for tracing (connection string from the resource's Overview page)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Azure AI Speech (optional, free F0 tier; first thing to cut)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus2

# Roboflow (video ingest)
ROBOFLOW_API_KEY=

# Hugging Face (SoccerTrack v2 download; a read token from an account that accepted the dataset terms)
HF_TOKEN=
